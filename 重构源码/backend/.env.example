# ---------------------------------------------------------------------------
# 内容中转平台 · 后端配置示例
# 复制为 backend/.env 后按需修改（不提交到版本库）
# 所有项都可省略：省略即使用 app/core/config.py 中的默认值
# ---------------------------------------------------------------------------

# ---- 基础 ----
APP_NAME=内容中转平台
DEBUG=false

# ---- 数据库 ----
# 默认 SQLite，零依赖即可跑；生产建议 PostgreSQL：
#   DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/contenthub
# DATABASE_URL=sqlite:///./data/app.db
DB_ECHO=false

# ---- 认证（生产必须替换） ----
JWT_SECRET=change-me-in-production-please-set-JWT_SECRET
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=14
# 首次启动只创建一个账号：超级管理员（登录后可在「个人资料」修改姓名/用户名/密码）
ADMIN_INITIAL_USERNAME=linan
ADMIN_INITIAL_NAME=林岸
ADMIN_INITIAL_PASSWORD=demo1234

# ---- 存储 ----
STORAGE_BACKEND=local
# STORAGE_ROOT=D:/data/contenthub-storage
MAX_UPLOAD_MB=2048
STORAGE_QUOTA_BYTES=214748364800

# ---- 媒体处理 ----
# 未安装 ffmpeg 时视频任务会降级为「复制源文件」并在结果里注明 engine=copy
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# auto | ffmpeg | copy
RENDER_ENGINE=auto

# ---- Worker ----
# inline：进程内线程池，免 Redis；external：独立进程消费（预留横向扩展）
WORKER_MODE=inline
WORKER_CONCURRENCY=2
CLAIM_TIMEOUT_MINUTES=30

# ---- AI（留空则走内置本地模板，engine=local-template） ----
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_TIMEOUT_SECONDS=60

# ---- 前端 ----
# 开发期 Vite 端口跨域白名单；生产由后端托管 frontend/dist 时可留空
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_FRONTEND=true
